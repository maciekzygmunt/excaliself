---
// Three small illustrations for the folders row: nest, star, drag.
import Icon from "./Icon.astro"
---

<div class="grid gap-4 sm:grid-cols-3">
  <figure class="card flex flex-col p-4">
    <ul class="flex flex-col gap-2 text-sm">
      <li class="flex items-center gap-2"><Icon name="folder" size={16} class="text-muted-foreground" /> Product</li>
      <li class="ml-3 flex items-center gap-2 border-l border-hairline pl-3"><Icon name="folder" size={16} class="text-muted-foreground" /> Onboarding</li>
      <li class="ml-6 flex items-center gap-2 border-l border-hairline pl-3"><Icon name="folder" size={16} class="text-muted-foreground" /> Emails</li>
      <li class="ml-9 flex items-center gap-2 rounded-md bg-well py-1 pl-3 font-medium text-iris-strong"><Icon name="file" size={16} /> Welcome</li>
    </ul>
    <figcaption class="mt-4 text-xs font-medium text-muted-foreground">Nest without limit</figcaption>
  </figure>
  <figure class="card flex flex-col p-4">
    <ul class="flex flex-col gap-2 text-sm">
      {["Signup flow", "Service map", "Data model"].map((name) => (
        <li class="flex items-center gap-2"><Icon name="star" weight="fill" size={16} class="text-iris" /> {name}</li>
      ))}
      <li class="flex items-center gap-2 text-muted-foreground"><Icon name="star" size={16} /> Kitchen layout</li>
    </ul>
    <figcaption class="mt-4 text-xs font-medium text-muted-foreground">Star the daily ones</figcaption>
  </figure>
  <figure class="card flex flex-col p-4">
    <ul class="flex flex-col gap-2 text-sm">
      <li class="flex items-center gap-2 rounded-md border-2 border-iris bg-iris-muted px-2 py-1 font-medium"><Icon name="folder-open" size={16} class="text-iris" /> Design</li>
      <li class="flex items-center gap-2 px-2 py-1"><Icon name="folder" size={16} class="text-muted-foreground" /> Retros</li>
      <li class="ml-6 flex rotate-[-3deg] items-center gap-2 rounded-md border border-keycap-border bg-panel px-2 py-1 shadow-panel"><Icon name="file" size={16} class="text-muted-foreground" /> Service map</li>
    </ul>
    <figcaption class="mt-4 text-xs font-medium text-muted-foreground">Drag to move</figcaption>
  </figure>
</div>
