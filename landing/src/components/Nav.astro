---
import Icon from "./Icon.astro"
import Selection from "./Selection.astro"
import { line, pen } from "../lib/sketch"

const repo = "https://github.com/maciekzygmunt/excaliself"
const base = import.meta.env.BASE_URL
const links = [
  { href: `${base}#tour`, label: "Tour" },
  { href: `${base}#deploy`, label: "Deploy" },
  { href: `${base}#faq`, label: "FAQ" },
  { href: `${base}docs/`, label: "Docs" },
]
// One rough underline per link, each with its own wobble.
const underline = (seed: number) => line([[0, 4], [100, 4]], { seed, stroke: pen, width: 2, roughness: 1.4 }).filter((p) => p.draw)[0].d
---

<header class="sticky top-0 z-50 border-b border-transparent bg-ground transition-[border-color] duration-300 [.is-scrolled_&]:border-line" data-header>
  <nav aria-label="Main" class="page flex h-16 items-center justify-between gap-6">
    <a href={base} class="selectable relative flex items-center gap-2.5 py-1 pr-1 font-semibold tracking-tight" aria-label="Excaliself home">
      <img src={`${base}favicon.svg`} alt="" width="28" height="28" />
      <span class="text-lg">Excaliself</span>
      <Selection />
    </a>
    <div class="hidden items-center gap-8 md:flex">
      <ul class="flex items-center gap-7 text-[0.9375rem] font-medium" data-nav-links>
        {links.map((l, i) => (
          <li>
            <a href={l.href} class="draw-link" aria-current={l.label === "Docs" && Astro.url.pathname.startsWith(`${base}docs`) ? "true" : undefined}>
              {l.label}
              <svg viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true">
                <path d={underline(40 + i)} fill="none" stroke={pen} stroke-width="2" stroke-linecap="round" pathLength="1" vector-effect="non-scaling-stroke" />
              </svg>
            </a>
          </li>
        ))}
      </ul>
      <a href={repo} class="btn btn-line selectable !min-h-10 !px-3.5 text-[0.9375rem]">
        <Icon name="github-logo" size={18} />
        GitHub
        <Selection />
      </a>
    </div>
    <button
      type="button"
      class="btn btn-line selectable !min-h-10 !px-4 text-[0.9375rem] md:hidden"
      aria-expanded="false"
      aria-controls="menu"
      data-menu-toggle
    >
      <span data-menu-label>Menu</span>
      <Selection />
    </button>
  </nav>
</header>

<div id="menu" class="menu-overlay fixed inset-0 z-40 flex flex-col bg-ground px-gutter pt-24 pb-10 md:hidden" data-menu>
  <nav aria-label="Menu" class="flex flex-col">
    {links.map((l) => (
      <a href={l.href} class="border-b border-line py-4 text-4xl font-semibold tracking-tight">{l.label}</a>
    ))}
    <a href={repo} class="flex items-center gap-3 py-4 text-4xl font-semibold tracking-tight">
      GitHub
      <Icon name="arrow-up-right" size={28} />
    </a>
  </nav>
  <p class="hand mt-auto text-xl text-pen">your team's whiteboard, on your server</p>
</div>
