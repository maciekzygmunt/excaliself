---
import Sketch from "./Sketch.astro"
import { line, pen } from "../lib/sketch"

const repo = "https://github.com/maciekzygmunt/excaliself"
const base = import.meta.env.BASE_URL
const links = [
  { href: `${base}docs/`, label: "Docs" },
  { href: `${base}blog/`, label: "Blog" },
  { href: repo, label: "Source code" },
  { href: `${base}#sponsors`, label: "Sponsor" },
  { href: "https://x.com/0xzygmunt", label: "X" },
  { href: `${repo}/blob/main/LICENSE`, label: "License" },
  { href: `${base}privacy/`, label: "Privacy" },
  { href: `${base}fonts/Excalifont-OFL.txt`, label: "Font license" },
]
const underline = line([[8, 18], [420, 10], [990, 22]], { seed: 77, stroke: pen, width: 3, roughness: 1.2 })
---

<footer class="page overflow-hidden pt-20 pb-6 md:pt-28">
  <div class="flex flex-col gap-4 border-t border-line pt-6 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
    <div class="flex flex-col items-start gap-3">
      <p>Excaliself is MIT licensed. Not affiliated with Excalidraw.</p>
      <a href="https://www.opensourcealternatives.to" class="opacity-50 grayscale transition duration-300 hover:opacity-100 hover:grayscale-0 focus-visible:opacity-100 focus-visible:grayscale-0">
        {/* A local copy, so visitors' browsers don't contact a third party */}
        <img src={`${base}badge-osa.svg`} alt="As seen on Open Source Alternatives" width="216" height="16" loading="lazy" />
      </a>
    </div>
    <nav aria-label="Footer">
      <ul class="flex flex-wrap gap-x-6 gap-y-1">
        {links.map((l) => (
          <li><a href={l.href} class="inline-block py-2 transition-colors duration-300 hover:text-ink">{l.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="pointer-events-none relative mt-10 md:mt-14" aria-hidden="true" data-draw>
    <p class="display text-center leading-[0.8] text-ink [font-size:min(22vw,20rem)]">Excaliself</p>
    <svg viewBox="0 0 1000 32" class="mx-auto -mt-1 block w-[86%] overflow-visible" preserveAspectRatio="none">
      <Sketch parts={underline} />
    </svg>
  </div>
</footer>
