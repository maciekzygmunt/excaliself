---
// A dark terminal with a Copy button (wired in scripts/motion.ts). Lines that start with "#" render as comments.
import Icon from "./Icon.astro"
import Selection from "./Selection.astro"

interface Props {
  lines: string[]
  class?: string
}
const { lines, class: className } = Astro.props
---

<div class={`rounded-xl bg-ink text-neutral-200 ${className ?? ""}`} data-terminal>
  <div class="flex items-center justify-between border-b border-white/10 py-2 pr-2 pl-5">
    <span class="font-mono text-xs text-neutral-400">Terminal</span>
    <button type="button" class="btn selectable !min-h-10 !px-3 text-sm text-neutral-200 hover:bg-white/10" data-copy>
      <Icon name="copy" size={16} />
      <span data-copy-label>Copy</span>
      <Selection />
    </button>
  </div>
  <pre class="p-5 font-mono text-xs leading-relaxed md:p-6 md:text-sm"><code>{lines.map((line) => line.startsWith("#") ? <span class="block whitespace-pre-wrap pl-[2ch] -indent-[2ch] [overflow-wrap:anywhere] text-neutral-400">{line}</span> : <span class="block whitespace-pre-wrap pl-[2ch] -indent-[2ch] [overflow-wrap:anywhere]"><span class="select-none text-[#a39dea]">$ </span>{line}</span>)}</code></pre>
</div>
