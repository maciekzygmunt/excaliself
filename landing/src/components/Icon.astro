---
// Inlines a Phosphor icon from @phosphor-icons/core (regular or fill weight).
const regular = import.meta.glob<string>("/node_modules/@phosphor-icons/core/assets/regular/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
})
const fill = import.meta.glob<string>("/node_modules/@phosphor-icons/core/assets/fill/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
})

interface Props {
  name: string
  size?: number
  class?: string
  weight?: "regular" | "fill"
}
const { name, size = 20, class: className, weight = "regular" } = Astro.props
const file =
  weight === "fill"
    ? fill[`/node_modules/@phosphor-icons/core/assets/fill/${name}-fill.svg`]
    : regular[`/node_modules/@phosphor-icons/core/assets/regular/${name}.svg`]
if (!file) throw new Error(`Unknown Phosphor icon: ${name} (${weight})`)
const inner = file.replace(/^<svg[^>]*>/, "").replace(/<\/svg>\s*$/, "")
---

<svg viewBox="0 0 256 256" width={size} height={size} fill="currentColor" aria-hidden="true" class={className} set:html={inner} />
