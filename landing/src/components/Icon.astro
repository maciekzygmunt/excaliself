---
// Inlines a Phosphor icon (regular weight) from @phosphor-icons/core.
const icons = import.meta.glob<string>("/node_modules/@phosphor-icons/core/assets/regular/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
})

interface Props {
  name: string
  size?: number
  class?: string
}
const { name, size = 20, class: className } = Astro.props
const file = icons[`/node_modules/@phosphor-icons/core/assets/regular/${name}.svg`]
if (!file) throw new Error(`Unknown Phosphor icon: ${name}`)
const inner = file.replace(/^<svg[^>]*>/, "").replace(/<\/svg>\s*$/, "")
---

<svg viewBox="0 0 256 256" width={size} height={size} fill="currentColor" aria-hidden="true" class={className} set:html={inner} />
