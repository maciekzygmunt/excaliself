---
// Two trashed drawings with their restore action and the days left before purge.
import Icon from "./Icon.astro"

const items = [
  { name: "Old login sketch", days: 27, thumb: "/shots/thumb-wireframe.png", alt: "Preview of a settings page wireframe" },
  { name: "Sprint 11 retro", days: 21, thumb: "/shots/thumb-retro.png", alt: "Preview of a retro board with three columns" },
]
---

<figure class="card p-4">
  <div class="flex items-center justify-between px-2 pb-3">
    <span class="flex items-center gap-2 text-sm font-semibold"><Icon name="trash-simple" size={16} class="text-muted-foreground" /> Trash</span>
    <span class="text-xs font-medium text-muted-foreground">Purged after 30 days</span>
  </div>
  <ul class="divide-y divide-hairline">
    {items.map((item) => (
      <li class="flex items-center gap-4 px-2 py-3">
        <img src={item.thumb} width="594" height="440" alt={item.alt} loading="lazy" decoding="async" class="w-16 shrink-0 rounded border border-hairline" />
        <div class="min-w-0 flex-1">
          <p class="truncate text-sm font-medium">{item.name}</p>
          <div class="mt-2 h-1 overflow-hidden rounded-full bg-well">
            <div class="h-full rounded-full bg-iris" style={`width: ${(item.days / 30) * 100}%`}></div>
          </div>
          <p class="mt-1 text-xs text-muted-foreground">Purges in {item.days} days</p>
        </div>
        <span class="keycap inline-flex items-center gap-2 px-3 py-2 text-sm font-semibold">
          <Icon name="arrow-counter-clockwise" size={14} /> Restore
        </span>
      </li>
    ))}
  </ul>
</figure>
