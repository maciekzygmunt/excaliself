---
import Layout from "../layouts/Layout.astro"
import Icon from "../components/Icon.astro"
import Selection from "../components/Selection.astro"
import Sketch from "../components/Sketch.astro"
import HeroDiagram from "../components/HeroDiagram.astro"
import Tour from "../components/Tour.astro"
import { Image } from "astro:assets"
import { arrow, ellipse, ink, line, pen, rect } from "../lib/sketch"
import editorShot from "../assets/shots/editor.png"
import paletteShot from "../assets/shots/palette.png"
import membersShot from "../assets/shots/members.png"
import liveShot from "../assets/shots/live.png"
import teamShot from "../assets/shots/team.png"

const repo = "https://github.com/maciekzygmunt/excaliself"

// Alternating image/text rows. `cols` places the figure on the 12-column grid.
const features = [
  {
    title: "The editor you already know",
    body: "The full Excalidraw canvas. Every stroke saves on its own, and images you paste are stored with the drawing.",
    note: "the official editor package, unchanged",
    image: editorShot,
    crop: "",
    alt: "The Excalidraw toolbar above a signup flowchart in the Excaliself editor",
    figure: "lg:col-span-7 lg:col-start-1",
    text: "lg:col-span-4 lg:col-start-9 lg:self-center",
  },
  {
    title: "Draw together, live",
    body: "Open the same drawing and see everyone's cursors and edits as they happen. Send a share link to someone outside the team, and they can draw with you without an account.",
    note: "Tomasz and Priya, editing right now",
    image: liveShot,
    crop: "",
    alt: "The Signup flow drawing with the cursors of Tomasz and Priya, a box that Tomasz has selected, and a new box that Priya just drew",
    figure: "lg:col-span-7 lg:col-start-6 lg:row-start-1",
    text: "lg:col-span-4 lg:col-start-1 lg:row-start-1 lg:self-center",
  },
  {
    title: "A space the whole team shares",
    body: "A Private | Team switch in the sidebar. Team folders and drawings belong to everyone, and a badge shows who is in each drawing right now. Move a private drawing over when it is ready.",
    note: "shows up once you invite someone",
    image: teamShot,
    crop: "",
    alt: "The Team space home: the sidebar switch set to Team with two people live, team folders, and drawing cards with their creators",
    figure: "lg:col-span-7 lg:col-start-1",
    text: "lg:col-span-4 lg:col-start-9 lg:self-center",
  },
  {
    title: "Press ⌘K and jump anywhere",
    body: "Fuzzy search over drawings, folders, and actions. Type a few letters, press enter, and keep your hands on the keyboard.",
    note: "one word matches folders and drawings",
    image: paletteShot,
    crop: "",
    alt: "The command palette filtering drawings and folders by the word retro",
    figure: "lg:col-span-7 lg:col-start-6 lg:row-start-1",
    text: "lg:col-span-4 lg:col-start-1 lg:row-start-1 lg:self-center",
  },
  {
    title: "Your team only",
    body: "The first visitor becomes the admin. Everyone else joins through a single use invite link. Admins manage roles and password resets from Settings.",
    note: "no public signup page",
    image: membersShot,
    crop: "aspect-[2760/790]",
    alt: "The members list in Settings with admin and member roles",
    figure: "lg:col-span-7 lg:col-start-1",
    text: "lg:col-span-4 lg:col-start-9 lg:self-center",
  },
]

const steps = [
  { title: "Download two files", body: "The compose file and an example env file, straight from the repository." },
  { title: "Set three variables", body: "A Postgres password, a session secret, and your public URL." },
  { title: "Start it and open the URL", body: "The first visit creates the admin account. Share invite links from Settings." },
]

const compose = [
  "mkdir excaliself && cd excaliself",
  "curl -fsSLO https://raw.githubusercontent.com/maciekzygmunt/excaliself/main/docker-compose.yaml",
  "curl -fsSL -o .env https://raw.githubusercontent.com/maciekzygmunt/excaliself/main/.env.example",
  "# set POSTGRES_PASSWORD, BETTER_AUTH_SECRET, and BASE_URL in .env",
  "docker compose up -d",
]

// `more` is an optional in-page link after the answer; the FAQ schema gets the plain answer.
const faq: { q: string; a: string; more?: { href: string; label: string } }[] = [
  {
    q: "Is this a fork of Excalidraw?",
    a: "No. Excaliself embeds the official Excalidraw editor package unchanged and adds accounts, folders, search, and trash around it. Editor updates arrive with each release.",
  },
  {
    q: "What do I need to run it?",
    a: "A server with Docker. The compose file starts the app and a Postgres database together. The prebuilt image runs on amd64 and arm64 and needs no build step.",
  },
  {
    q: "Where are my drawings stored?",
    a: "In your own Postgres database, including pasted images. Back up the pgdata volume and you have everything. Nothing is sent to a third party.",
  },
  {
    q: "How do updates work?",
    a: "Pull the new image and start it again. Database migrations run when the app starts. Pin a release with EXCALISELF_VERSION or follow latest.",
  },
  {
    q: "Can I use it on Coolify?",
    a: "Yes. Add the repository as a Docker Compose resource, point it at docker-compose.coolify.yaml, and click Deploy. Coolify creates the database, the secrets, and a domain.",
  },
  {
    q: "How do people join?",
    a: "The first visitor creates the admin account. Admins send invite links from Settings and can manage members, roles, and password resets there.",
  },
  {
    q: "Does it support live collaboration?",
    a: "Yes. Everyone in a drawing sees the cursors and edits of the others as they happen. Team drawings are always live, and a share link lets people without an account join a drawing.",
  },
  {
    q: "What does it cost?",
    a: "Nothing. Excaliself is open source under the MIT license. You pay only for the server you run it on.",
    more: { href: "#sponsors", label: "If it saves your team time, you can sponsor it." },
  },
]

const appSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Excaliself",
  description: "Self-hosted Excalidraw for teams, with a shared Team space, live collaboration, folders, search, and a trash can.",
  url: new URL(import.meta.env.BASE_URL, Astro.site).href,
  image: new URL(`${import.meta.env.BASE_URL}og.png`, Astro.site).href,
  applicationCategory: "DesignApplication",
  operatingSystem: "Docker",
  license: "https://opensource.org/licenses/MIT",
  codeRepository: repo,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
}

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
}

// Hand-drawn pieces: the circle around "a home", the shelf sketch, step boxes and their arrows.
const circle = ellipse(200, 60, 384, 104, { seed: 300, stroke: pen, width: 3, roughness: 1.3 })
const noteArrow = arrow([[66, 60], [34, 46], [24, 6]], { seed: 305, stroke: pen, width: 2, head: 12 })
// Excaliself as a frame with a folder sidebar, the Excalidraw window inside it unchanged.
const shelf = [
  ...rect(10, 40, 420, 250, { seed: 338, stroke: pen, width: 2, roughness: 0.8, r: 18 }),
  ...[96, 130, 164].flatMap((y, i) => [
    ...rect(28, y - 9, 18, 14, { seed: 370 + i * 3, fill: ["#a5d8ff", "#b2f2bb", "#ffec99"][i], width: 1.4, r: 3 }),
    ...line([[54, y - 2], [96 - i * 10, y - 2]], { seed: 371 + i * 3, width: 1.6 }),
  ]),
  ...rect(122, 62, 290, 208, { seed: 340, fill: "#ffffff", r: 14 }),
  ...line([[122, 100], [412, 100]], { seed: 342 }),
  ...[144, 164, 184].flatMap((x, i) => ellipse(x, 81, 11, 11, { seed: 344 + i, width: 1.6 })),
  ...rect(187, 136, 160, 96, { seed: 350, fill: "#ffec99", r: 10 }),
]
const captionArrow = arrow([[40, 34], [20, 28], [14, 4]], { seed: 360, stroke: pen, width: 2, head: 10 })
// Empty logo slots, 2×2 in a 560×250 sketch, until the first sponsors arrive.
const slots = [0, 1, 2, 3].map((i) => ({
  x: 10 + (i % 2) * 280,
  y: 10 + Math.floor(i / 2) * 120,
  parts: rect(10 + (i % 2) * 280, 10 + Math.floor(i / 2) * 120, 260, 100, { seed: 380 + i * 2, stroke: "#8a8a93", width: 2, r: 14 }),
}))
const stepBox = (i: number) => rect(4, 4, 492, 132, { seed: 310 + i * 4, fill: ["#d0bfff", "#ffec99", "#b2f2bb"][i], r: 14 })
const stepArrow = (i: number) => arrow([[20, 2], [22, 26], [20, 50]], { seed: 330 + i * 3, head: 12 })
---

<Layout
  title="Excaliself: self-hosted Excalidraw for your team"
  description="Self-hosted Excalidraw for your team: the full canvas with a shared Team space, live collaboration, folders, and search. Every drawing is stored in your own Postgres."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <main id="main">
    <!-- Hero: headline over the sketch of where drawings live -->
    <section class="hero dots" data-hero>
      <div class="hero-stage page flex flex-col pt-10 pb-12 md:pt-16">
        <h1 class="display text-mega">Your team's whiteboard,<br class="hidden md:block" /> on your server.</h1>
        <div class="mt-8 flex flex-col gap-7 md:mt-10 lg:flex-row lg:items-end lg:gap-14">
          <p class="max-w-[34rem] text-lede text-muted">
            Excaliself is self-hosted Excalidraw: the full canvas, plus a shared Team space, live collaboration, folders,
            and search. Every drawing lives in your own Postgres.
          </p>
          <div class="flex flex-wrap items-center gap-4">
            <a href="#deploy" class="btn btn-ink selectable max-sm:w-full">Deploy in five minutes<Selection /></a>
            <a href={repo} class="btn btn-line selectable max-sm:w-full"><Icon name="github-logo" size={18} />Read the source<Selection /></a>
          </div>
        </div>
        <div class="hero-diagram mt-10 md:mt-12">
          <HeroDiagram layout="wide" class="hidden h-full w-full md:block" />
          <HeroDiagram layout="tall" class="mx-auto block w-full max-w-[420px] md:hidden" />
        </div>
      </div>
    </section>

    <!-- Tour: the real home screen, annotated -->
    <section id="tour" class="page scroll-mt-20 pt-20 pb-16 md:pt-28">
      <div class="grid-12">
        <h2 class="heading col-span-12 lg:col-span-9">Everything around the canvas, nothing on top of it.</h2>
        <p class="col-span-12 mt-6 max-w-[34rem] text-lede text-muted lg:col-span-6">
          Excalidraw stays untouched. Excaliself adds the parts a team needs to keep drawings for years.
        </p>
      </div>
      <Tour />
    </section>

    <!-- Features: alternating pairs -->
    <section aria-labelledby="features-title" class="page py-16 md:py-24">
      <h2 id="features-title" class="sr-only">Features</h2>
      <div class="flex flex-col gap-20 md:gap-32">
        {features.map((f) => (
          <article class="grid-12 items-start gap-y-8" data-reveal>
            <figure class={`col-span-12 ${f.figure}`}>
              <div class={`overflow-hidden rounded-xl shadow-[0_0_0_1px_rgb(30_30_30/0.1),0_24px_60px_-24px_rgb(30_30_30/0.22)] ${f.crop}`}>
              <Image
                src={f.image}
                widths={[800, 1600]}
                sizes="(min-width: 1024px) 60vw, calc(100vw - 2.5rem)"
                alt={f.alt}
                class="block h-auto w-full object-cover object-top"
              />
              </div>
              <figcaption class="hand mt-2 flex items-start gap-1 text-lg text-pen" data-draw>
                <svg viewBox="0 0 48 40" class="w-10 shrink-0 overflow-visible" aria-hidden="true"><Sketch parts={captionArrow} /></svg>
                <span class="pt-4">{f.note}</span>
              </figcaption>
            </figure>
            <div class={`col-span-12 ${f.text}`}>
              <h3 class="text-head leading-[1.02] font-semibold tracking-[-0.035em]">{f.title}</h3>
              <p class="mt-4 text-muted">{f.body}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Statement: Excalidraw is the canvas, Excaliself is the home around it -->
    <section aria-label="Where your drawings live" class="dots py-20 md:py-32">
      <div class="page grid-12 items-center gap-y-12">
        <div class="col-span-12 lg:col-span-7">
          <p class="heading max-w-[17ch]">
            Excalidraw is the canvas. Excaliself gives every drawing{" "}
            <span class="relative inline-block whitespace-nowrap" data-draw>
              a home
              <svg viewBox="0 0 400 120" class="pointer-events-none absolute -inset-x-[10%] -inset-y-[24%] h-[148%] w-[120%] overflow-visible" preserveAspectRatio="none" aria-hidden="true">
                <Sketch parts={circle} />
              </svg>
            </span>
            {" "}on your server.
          </p>
          <div class="mt-6 flex items-start gap-2 md:ml-[14%]" data-draw>
            <svg viewBox="0 0 80 64" class="w-14 shrink-0 overflow-visible md:w-20" aria-hidden="true">
              <Sketch parts={noteArrow} />
            </svg>
            <p class="hand pt-9 text-2xl text-pen md:pt-12">so they open on any laptop, for anyone on the team</p>
          </div>
        </div>
        <svg viewBox="0 0 440 340" class="col-span-12 mx-auto w-full max-w-[440px] overflow-visible lg:col-span-5" role="img" aria-labelledby="shelf-title" data-draw>
          <title id="shelf-title">Sketch: an Excalidraw window inside a larger frame labeled Excaliself, which adds a folder sidebar. Note: the canvas you know, untouched.</title>
          <Sketch parts={shelf} />
          <g font-family="Excalifont, cursive">
            <text class="sk-t" x="24" y="28" font-size="24" fill={pen}>Excaliself</text>
            <text class="sk-t" x="290" y="88" font-size="17" fill="#5c5c66">excalidraw</text>
            <text class="sk-t" x="267" y="191" font-size="22" fill={ink} text-anchor="middle">Q4 roadmap</text>
            <text class="sk-t" x="220" y="330" font-size="22" fill={pen} text-anchor="middle">the canvas you know, untouched</text>
          </g>
        </svg>
      </div>
    </section>

    <!-- Deploy -->
    <section id="deploy" class="page scroll-mt-20 py-16 md:py-24">
      <div class="grid-12 gap-y-6">
        <h2 class="heading col-span-12 lg:col-span-8">One compose file. That is the whole install.</h2>
        <p class="col-span-12 max-w-[34rem] text-lede text-muted lg:col-span-6">
          It starts the prebuilt app image and a Postgres container, on amd64 and arm64. Migrations apply on start, so an
          update is a redeploy.
        </p>
      </div>
      <div class="grid-12 mt-14 gap-y-12 md:mt-20">
        <div class="col-span-12 lg:col-span-5">
          <ol class="flex flex-col" data-draw>
            {steps.map((s, i) => (
              <li class="flex flex-col">
                <div class="relative px-7 py-6">
                  <svg viewBox="0 0 500 140" preserveAspectRatio="none" class="absolute inset-0 h-full w-full overflow-visible" aria-hidden="true">
                    <Sketch parts={stepBox(i)} />
                  </svg>
                  <div class="relative">
                    <h3 class="text-xl font-semibold tracking-tight"><span class="hand mr-2 text-pen">{i + 1}.</span>{s.title}</h3>
                    <p class="mt-1.5 text-[0.9375rem] text-[#3d3d45]">{s.body}</p>
                  </div>
                </div>
                {i < steps.length - 1 && (
                  <svg viewBox="0 0 40 52" class="ml-12 h-13 w-10 overflow-visible" aria-hidden="true">
                    <Sketch parts={stepArrow(i)} />
                  </svg>
                )}
              </li>
            ))}
          </ol>
          <a href={`${repo}#deploy`} class="group link mt-10 inline-flex items-center gap-2 font-semibold">
            Full deployment guide, including Coolify
            <Icon name="arrow-right" size={16} class="transition-transform duration-300 group-hover:translate-x-1" />
          </a>
        </div>
        <div class="col-span-12 self-start rounded-xl bg-ink text-neutral-200 lg:sticky lg:top-24 lg:col-span-7" data-terminal>
          <div class="flex items-center justify-between border-b border-white/10 py-2 pr-2 pl-5">
            <span class="font-mono text-xs text-neutral-400">Terminal</span>
            <button type="button" class="btn selectable !min-h-10 !px-3 text-sm text-neutral-200 hover:bg-white/10" data-copy>
              <Icon name="copy" size={16} />
              <span data-copy-label>Copy</span>
              <Selection />
            </button>
          </div>
          <pre class="p-5 font-mono text-xs leading-relaxed md:p-6 md:text-sm"><code>{compose.map((line) => line.startsWith("#") ? <span class="block whitespace-pre-wrap pl-[2ch] -indent-[2ch] [overflow-wrap:anywhere] text-neutral-400">{line}</span> : <span class="block whitespace-pre-wrap pl-[2ch] -indent-[2ch] [overflow-wrap:anywhere]"><span class="select-none text-[#a39dea]">$ </span>{line}</span>)}</code></pre>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="page scroll-mt-20 py-16 md:py-20">
      <div class="grid-12 gap-y-10">
        <div class="col-span-12 lg:col-span-4">
          <h2 class="text-head leading-[1.02] font-semibold tracking-[-0.035em]">Questions before you deploy</h2>
          <p class="mt-4 text-muted">
            Anything missing? <a href={`${repo}/issues`} class="link font-medium text-ink">Open an issue</a> and it gets answered there.
          </p>
        </div>
        <div class="col-span-12 border-t border-line lg:col-span-7 lg:col-start-6">
          {faq.map((f) => (
            <details class="border-b border-line">
              <summary class="flex cursor-pointer items-center justify-between gap-6 py-5 text-lg font-medium transition-colors duration-300 hover:text-pen">
                {f.q}
                <Icon name="plus" size={18} class="caret shrink-0 text-muted" />
              </summary>
              <p class="max-w-[60ch] pb-6 text-muted">
                {f.a}
                {f.more && <>{" "}<a href={f.more.href} class="link font-medium text-ink">{f.more.label}</a></>}
              </p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Sponsors -->
    <section id="sponsors" aria-labelledby="sponsors-title" class="page scroll-mt-20 py-16 md:py-24">
      <div class="grid-12 items-center gap-y-12">
        <div class="col-span-12 lg:col-span-5">
          <h2 id="sponsors-title" class="text-head leading-[1.02] font-semibold tracking-[-0.035em]">Help keep it free</h2>
          <p class="mt-4 max-w-[34rem] text-muted">
            Excaliself is MIT licensed and has no paid plan. Sponsorships on GitHub pay for the hours that go into fixes,
            updates, and new features like the Team space.
          </p>
          <a href="https://github.com/sponsors/maciekzygmunt" class="btn btn-ink selectable mt-7 max-sm:w-full">
            <Icon name="heart" size={18} />Sponsor on GitHub<Selection />
          </a>
        </div>
        <figure class="col-span-12 lg:col-span-6 lg:col-start-7" data-draw>
          <svg viewBox="0 0 560 250" class="w-full overflow-visible" role="img" aria-labelledby="slots-title">
            <title id="slots-title">Four empty sponsor logo slots</title>
            <g stroke-dasharray="9 8">{slots.map((s) => <Sketch parts={s.parts.map((p) => ({ ...p, draw: false }))} />)}</g>
            <g font-family="Excalifont, cursive" font-size="22" fill="#8a8a93" text-anchor="middle">
              {slots.map((s) => <text class="sk-t" x={s.x + 130} y={s.y + 57}>your logo</text>)}
            </g>
          </svg>
          <figcaption class="hand mt-4 text-center text-xl text-pen">these spots are waiting for the first sponsors</figcaption>
        </figure>
      </div>
    </section>

    <!-- Closing call to action -->
    <section aria-labelledby="cta-title" class="page pt-16 md:pt-24">
      <div class="grid-12 gap-y-8">
        <h2 id="cta-title" class="heading col-span-12 lg:col-span-8">Nothing to sign up for. Nothing to export later.</h2>
        <div class="col-span-12 flex flex-col gap-7 lg:col-span-4 lg:self-end">
          <p class="text-muted">No third party accounts, no telemetry, no lock in. Stop the container and your drawings are still in your Postgres.</p>
          <div class="flex flex-wrap gap-4">
            <a href="#deploy" class="btn btn-ink selectable max-sm:w-full">Deploy in five minutes<Selection /></a>
            <a href={repo} class="btn btn-line selectable max-sm:w-full"><Icon name="github-logo" size={18} />GitHub<Selection /></a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* Sticky stage on large screens: the hero owns extra scroll so the drawings can travel. */
  @media (min-width: 1024px) and (min-height: 640px) {
    .hero {
      height: 175svh;
    }
    .hero-stage {
      position: sticky;
      top: 4rem;
      height: calc(100svh - 4rem);
    }
    .hero-diagram {
      flex: 1;
      min-height: 0;
    }
  }
</style>
