---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro"
import { render } from "astro:content"
import Layout from "../../layouts/Layout.astro"
import DocsNav from "../../components/DocsNav.astro"
import Icon from "../../components/Icon.astro"
import { docHref, getDocsNav } from "../../lib/docs"

export const getStaticPaths = (async () => {
  const pages = (await getDocsNav()).flatMap((section) => section.pages)
  return pages.map((doc, i) => ({
    params: { slug: doc.id === "index" ? undefined : doc.id },
    props: { doc, prev: pages[i - 1], next: pages[i + 1] },
  }))
}) satisfies GetStaticPaths
type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { doc, prev, next } = Astro.props
const { Content, headings } = await render(doc)
const toc = headings.filter((h) => h.depth === 2)
const editUrl = `https://github.com/maciekzygmunt/excaliself/edit/main/landing/${doc.filePath}`
---

<Layout title={`${doc.data.title}: Excaliself docs`} description={doc.data.description}>
  <main id="main" class="page lg:grid lg:grid-cols-[14rem_minmax(0,1fr)] lg:gap-x-12 xl:grid-cols-[14rem_minmax(0,1fr)_12rem]">
    <aside class="sticky top-16 hidden max-h-[calc(100svh-4rem)] self-start overflow-x-hidden overflow-y-auto px-2 py-10 lg:block">
      <DocsNav current={doc.id} label="Docs" />
    </aside>

    <div class="min-w-0 pt-6 pb-10 lg:pt-10">
      <details class="mb-8 rounded-lg border border-line lg:hidden">
        <summary class="flex cursor-pointer items-center justify-between gap-4 px-4 py-3 font-medium">
          Docs menu
          <Icon name="plus" size={18} class="caret shrink-0 text-muted" />
        </summary>
        <div class="border-t border-line p-3">
          <DocsNav current={doc.id} label="Docs pages" />
        </div>
      </details>

      <article class="mx-auto max-w-[44rem]">
        <h1 class="text-head leading-[1.02] font-semibold tracking-[-0.035em]">{doc.data.title}</h1>
        <p class="mt-3 text-lede text-muted">{doc.data.description}</p>
        <div class="prose mt-8" data-docs-prose>
          <Content />
        </div>

        <p class="mt-12 text-sm">
          <a href={editUrl} class="inline-flex items-center gap-1.5 py-2 text-muted transition-colors duration-300 hover:text-ink">
            <Icon name="pencil-simple" size={16} />
            Edit this page on GitHub
          </a>
        </p>
        <nav aria-label="Previous and next page" class="mt-4 grid gap-3 border-t border-line pt-6 sm:grid-cols-2">
          {prev && (
            <a href={docHref(prev.id)} class="group rounded-lg py-2">
              <span class="block text-sm text-muted">Previous</span>
              <span class="font-medium transition-colors duration-300 group-hover:text-pen">{prev.data.title}</span>
            </a>
          )}
          {next && (
            <a href={docHref(next.id)} class="group rounded-lg py-2 sm:col-start-2 sm:text-right">
              <span class="block text-sm text-muted">Next</span>
              <span class="font-medium transition-colors duration-300 group-hover:text-pen">{next.data.title}</span>
            </a>
          )}
        </nav>
      </article>
    </div>

    {toc.length > 1 && (
      <aside class="sticky top-16 hidden max-h-[calc(100svh-4rem)] self-start overflow-y-auto py-10 xl:block">
        <nav aria-label="On this page">
          <p class="text-sm font-semibold">On this page</p>
          <ul class="mt-2.5 flex flex-col gap-2 text-sm">
            {toc.map((h) => (
              <li><a href={`#${h.slug}`} class="text-muted transition-colors duration-300 hover:text-ink">{h.text}</a></li>
            ))}
          </ul>
        </nav>
      </aside>
    )}
  </main>
</Layout>

<script>
  // Give each code block a copy button.
  for (const pre of document.querySelectorAll<HTMLPreElement>("[data-docs-prose] pre")) {
    const wrap = document.createElement("div")
    wrap.className = "code-block"
    pre.replaceWith(wrap)
    const button = document.createElement("button")
    button.type = "button"
    button.textContent = "Copy"
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(pre.textContent ?? "")
        button.textContent = "Copied"
      } catch {
        button.textContent = "Select and copy"
      }
      setTimeout(() => (button.textContent = "Copy"), 2000)
    })
    wrap.append(pre, button)
  }
</script>
