---
import { getCollection } from "astro:content"
import Layout from "../../layouts/Layout.astro"

const posts = (await getCollection("blog")).sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
const base = import.meta.env.BASE_URL
const fmt = (d: Date) => d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" })
---

<Layout title="Blog: Excaliself" description="Release notes and tutorials for Excaliself, the self-hosted Excalidraw.">
  <main id="main" class="page py-10">
    <div class="mx-auto max-w-[44rem]">
      <h1 class="text-head leading-[1.02] font-semibold tracking-[-0.035em]">Blog</h1>
      <p class="mt-3 text-lede text-muted">Release notes and tutorials.</p>
      <ul class="mt-10 flex flex-col gap-8">
        {posts.map((post) => (
          <li>
            <a href={`${base}blog/${post.id}/`} class="group block">
              <span class="block text-sm text-muted">{fmt(post.data.date)}</span>
              <span class="text-xl font-semibold tracking-tight transition-colors duration-300 group-hover:text-pen">{post.data.title}</span>
              <span class="mt-1 block text-muted">{post.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </main>
</Layout>
