---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro"
import { render } from "astro:content"
import Layout from "../../layouts/Layout.astro"
import { author, formatDate, getPosts, postHref } from "../../lib/blog"

export const getStaticPaths = (async () => {
  const posts = await getPosts()
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, others: posts.filter((p) => p.id !== post.id) },
  }))
}) satisfies GetStaticPaths
type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { post, others } = Astro.props
const { Content } = await render(post)
const base = import.meta.env.BASE_URL
const repo = "https://github.com/maciekzygmunt/excaliself"
const url = new URL(postHref(post.id), Astro.site).href
const published = post.data.date.toISOString()

const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: published,
  dateModified: published,
  url,
  mainEntityOfPage: url,
  image: new URL(`${base}og.png`, Astro.site).href,
  inLanguage: "en",
  author: { "@type": "Person", name: author.name, url: author.url },
  publisher: {
    "@type": "Organization",
    name: "Excaliself",
    url: new URL(base, Astro.site).href,
    logo: new URL(`${base}apple-touch-icon.png`, Astro.site).href,
  },
}
---

<Layout title={`${post.data.title}: Excaliself blog`} description={post.data.description} ogType="article">
  <Fragment slot="head">
    <meta property="article:published_time" content={published} />
    <meta property="article:author" content={author.name} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>

  <main id="main" class="page pt-10 pb-10 md:pt-16">
    <article class="mx-auto max-w-[44rem]">
      <p class="text-sm text-muted">
        <a href={`${base}blog/`} class="transition-colors duration-300 hover:text-ink">Blog</a>
        <span aria-hidden="true"> · </span>
        <time datetime={published.slice(0, 10)}>{formatDate(post.data.date)}</time>
        <span aria-hidden="true"> · </span>
        <a href={author.url} rel="author" class="transition-colors duration-300 hover:text-ink">{author.name}</a>
      </p>
      <h1 class="mt-4 text-head leading-[1.05] font-semibold tracking-[-0.035em]">{post.data.title}</h1>
      <p class="mt-4 text-lede text-muted">{post.data.description}</p>
      <div class="prose mt-10" data-copy-code>
        <Content />
      </div>

      <p class="mt-14 border-t border-line pt-6 text-muted">
        Excaliself is MIT licensed. The code is on <a href={repo} class="link font-medium text-ink">GitHub</a>, and the
        <a href={`${base}docs/`} class="link font-medium text-ink">docs</a> cover every deploy path and setting.
      </p>

      {others.length > 0 && (
        <nav aria-label="More posts" class="mt-10">
          <p class="text-sm font-semibold">More posts</p>
          <ul class="mt-3 flex flex-col gap-2">
            {others.map((p) => (
              <li><a href={postHref(p.id)} class="font-medium transition-colors duration-300 hover:text-pen">{p.data.title}</a></li>
            ))}
          </ul>
        </nav>
      )}
    </article>
  </main>
</Layout>

<script>
  import "../../scripts/copy-code"
</script>
