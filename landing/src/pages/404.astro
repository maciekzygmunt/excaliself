---
import Layout from "../layouts/Layout.astro"
---

<Layout title="Page not found: Excaliself" description="This page does not exist." noindex>
  <main id="main" class="mx-auto flex max-w-6xl flex-col items-center px-6 pt-24 pb-20 text-center">
    <p class="font-mono text-sm text-muted-foreground">404</p>
    <h1 class="mt-6 max-w-[680px] text-5xl font-semibold tracking-tight">This page is not on the canvas.</h1>
    <p class="mt-6 max-w-md text-lg text-muted-foreground">The address may be old or mistyped. The home page has everything that exists here.</p>
    <a href="/" class="button-primary mt-8">Back to the home page</a>
  </main>
</Layout>
