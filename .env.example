# Docker Compose deploy (docker-compose.yaml). Copy to .env and fill in.
# For local development use .env.dev.example instead.

# Required. Generate with: openssl rand -hex 24
# (hex only: the password is embedded in a connection URL)
POSTGRES_PASSWORD=

# Required, min 32 chars. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL users open in the browser, e.g. https://draw.example.com
BASE_URL=http://localhost:3000

# Optional
# Image tag: latest (newest release), a version like 1.2.3 or 1.2, or main
# EXCALISELF_VERSION=latest
# Host port the app is published on
# EXCALISELF_PORT=3000
# POSTGRES_USER=excaliself
# POSTGRES_DB=excaliself

# Optional single sign-on. See docs/deployment.md#single-sign-on.
# Redirect URI to register: <BASE_URL>/api/auth/callback/<google|microsoft|oidc>
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_NAME=SSO
# Email domains whose people get an account on their first SSO sign-in
# SSO_ALLOWED_DOMAINS=example.com
