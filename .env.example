# Required
BETTER_AUTH_SECRET=<run: openssl rand -base64 32>
BASE_URL=http://localhost:3000

# Postgres (used by docker-compose)
POSTGRES_USER=excaliself
POSTGRES_PASSWORD=<run: openssl rand -base64 16>
POSTGRES_DB=excaliself
POSTGRES_PORT=5432

# For local dev outside Docker (must match the above)
DATABASE_URL=postgresql://excaliself:<same-as-POSTGRES_PASSWORD>@localhost:5432/excaliself
